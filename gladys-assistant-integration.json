              }
            },
            {
              "value": "automatic",
              "label": {
                "en": "Automation / time control",
                "fr": "Automatisme / programmation",
                "de": "Automatik / Zeitsteuerung",
                "es": "Automatismo / programación"
              }
            },
            {
              "value": "web",
              "label": { "en": "Nuki Web", "fr": "Nuki Web", "de": "Nuki Web", "es": "Nuki Web" }
            },
            {
              "value": "accessory",
              "label": {
                "en": "Fob / accessory",
                "fr": "Télécommande / accessoire",
                "de": "Fob / Zubehör",
                "es": "Mando / accesorio"
              }
            },
            {
              "value": "homekit",
              "label": {
                "en": "HomeKit / Matter",
                "fr": "HomeKit / Matter",
                "de": "HomeKit / Matter",
                "es": "HomeKit / Matter"
              }
            },
            {
              "value": "mqtt",
              "label": { "en": "MQTT", "fr": "MQTT", "de": "MQTT", "es": "MQTT" }
            },
            {
              "value": "gladys",
              "label": { "en": "Gladys", "fr": "Gladys", "de": "Gladys", "es": "Gladys" }
            },
            {
              "value": "unknown",
              "label": { "en": "Unknown", "fr": "Inconnu", "de": "Unbekannt", "es": "Desconocido" }
            }
          ]
        },
        {
          "key": "user",
          "type": "string",
          "label": {
            "en": "Nuki user (Nuki Web)",
            "fr": "Utilisateur Nuki (Nuki Web)",
            "de": "Nuki-Benutzer (Nuki Web)",
            "es": "Usuario Nuki (Nuki Web)"
          },
          "placeholder": {
            "en": "Exact name, e.g. Alice",
            "fr": "Nom exact, ex. Alice",
            "de": "Genauer Name, z. B. Alice",
            "es": "Nombre exacto, p. ej. Alice"
          }
        }
      ],
      "variables": [
        {
          "key": "action",
          "type": "string",
          "label": { "en": "Operation", "fr": "Opération", "de": "Vorgang", "es": "Operación" }
        },
        {
          "key": "trigger",
          "type": "string",
          "label": {
            "en": "Operated by",
            "fr": "Actionnée par",
            "de": "Bedient über",
            "es": "Accionada por"
          }
        },
        {
          "key": "user",
          "type": "string",
          "label": {
            "en": "Nuki user",
            "fr": "Utilisateur Nuki",
            "de": "Nuki-Benutzer",
            "es": "Usuario Nuki"
          }
        },
        {
          "key": "device_name",
          "type": "string",
          "label": {
            "en": "Lock name",
            "fr": "Nom de la serrure",
            "de": "Name des Schlosses",
            "es": "Nombre de la cerradura"
          }
        }
      ]
    },
    {
      "key": "doorbell_ring",
      "label": {
        "en": "Nuki Opener: doorbell rang",
        "fr": "Nuki Opener : on a sonné",
